# --- Standard .gitignore for ASP.NET / Visual Studio ---

## OS-specific files
*.swp
._*
.DS_Store
Thumbs.db

## Visual Studio folders and files
# (user settings, cache, temporary files)
*.suo
*.user
*.userosscs
*.sln.docstates
.vs/
.idea/

## Build artifacts
# (the most important folders to ignore)
[Bb]in/
[Oo]bj/

## Files produced by the build
*.pdb
*.dll
*.exe
*.lib
*.sbr
*.obj

## Packages
# For the legacy packages.config format (NuGet)
packages/
# For NPM (when a front-end is used)
node_modules/

## Configuration files and secrets
# User Secrets files
*.secrets.json
# Local settings files (must never be committed)
appsettings.Local.json
*.env
secrets.toml

## Log and database files
*.log
logs/
*.mdf
*.ldf
*.sqlite
*.db

## Test results and reports
TestResults/
*.trx
*.coverlet.json
coverage.cobertura.xml

## Publish artifacts
publish/
[Rr]elease/
[Dd]ebug/
# (note: Release/ and Debug/ usually live inside bin/, but just in case)

## Tool-specific files
_ReSharper*/
*.DotSettings.user
